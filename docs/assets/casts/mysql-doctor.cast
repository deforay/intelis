[4.006019, "o", "\r\n"]
[79.803741, "o", "\r\n\u001b[1mInteLIS doctor\u001b[0m  ·  intelis-lab  ·  29 Oct 2026 11:11\r\n"]
[81.571822, "o", "\r\n\u001b[1;91m╭──────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[81.579211, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m✘ The database is not running.                                  \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[81.582112, "o", "\u001b[1;91m│\u001b[0m                                                                  \u001b[1;91m│\u001b[0m\r\n"]
[81.586389, "o", "\u001b[1;91m│\u001b[0m   InteLIS cannot show a single page without it, however          \u001b[1;91m│\u001b[0m\r\n"]
[81.590667, "o", "\u001b[1;91m│\u001b[0m   healthy the web server is.                                     \u001b[1;91m│\u001b[0m\r\n"]
[81.590728, "o", "\u001b[1;91m╰──────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
[81.590924, "o", "  Web server     \u001b[1;92m✔\u001b[0m  running\r\n  PHP            \u001b[1;92m✔\u001b[0m  8.4.27, all 25 extensions loaded\r\n  Files          \u001b[1;92m✔\u001b[0m  readable and writable\r\n"]
[81.592764, "o", "  Disk           \u001b[1;92m✔\u001b[0m  399G free\r\n"]
[81.59304, "o", "  Database       \u001b[1;91m✘\u001b[0m  stopped\r\n  Site           \u001b[1;91m✘\u001b[0m  error 500\r\n  InteLIS        \u001b[1;92m✔\u001b[0m  5.8.5, up to date\r\n"]
[81.662336, "o", "\r\n\u001b[1mDatabase\u001b[0m\r\n"]
[81.772293, "o", "\r\n\u001b[1;91m╭──────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[81.77477, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m✘ Settings were added to /etc/mysql/my.cnf above the first      \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[81.776408, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m  [section] heading, and the database will not read that file   \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[81.778241, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m  at all.                                                       \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[81.780173, "o", "\u001b[1;91m│\u001b[0m                                                                  \u001b[1;91m│\u001b[0m\r\n"]
[81.782777, "o", "\u001b[1;91m│\u001b[0m   Every setting has to sit under a heading such as [mysqld].     \u001b[1;91m│\u001b[0m\r\n"]
[81.784788, "o", "\u001b[1;91m│\u001b[0m   The server stops at the first line and never starts.           \u001b[1;91m│\u001b[0m\r\n\u001b[1;91m╰──────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[81.785046, "o", "\r\n  Server         \u001b[1;91m✘\u001b[0m  MySQL, stopped\r\n"]
[81.786347, "o", "  Disk           \u001b[1;92m✔\u001b[0m  399G free\r\n  Memory         \u001b[1;92m✔\u001b[0m  enough\r\n"]
[81.786418, "o", "  Settings       \u001b[1;91m✘\u001b[0m  a setting is refused\r\n"]
[81.786584, "o", "  Data files     \u001b[1;92m✔\u001b[0m  /var/lib/mysql\r\n  InteLIS login  \u001b[2m·\u001b[0m  not checked\r\n"]
[81.786876, "o", "\r\n\u001b[1mRepairs\u001b[0m\r\n  \u001b[1;96m→\u001b[0m  Disable the settings that were added above the first heading in /etc/mysql/my.cnf.\r\n     Do this now? [y/N]: "]
[82.987879, "o", "y\r\n"]
[82.994206, "o", "  \u001b[1;92m✔\u001b[0m  Done.\r\n"]
[82.995623, "o", "  \u001b[1;96m→\u001b[0m  Starting the database...\r\n"]
[84.283028, "o", "\r\n"]
[84.287259, "o", "  \u001b[1;96m›\u001b[0m  Database report: /home/labuser/mysql-report.txt\r\n"]
[84.529233, "o", "\r\n\u001b[1;92m╭──────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[84.532825, "o", "\u001b[1;92m│\u001b[0m \u001b[1;92m✔ InteLIS is working again.                                     \u001b[0m \u001b[1;92m│\u001b[0m\r\n"]
[84.534956, "o", "\u001b[1;92m│\u001b[0m                                                                  \u001b[1;92m│\u001b[0m\r\n"]
