[4.561601, "o", "\r\n\u001b[1mInteLIS doctor\u001b[0m  ·  intelis-lab  ·  29 Oct 2026 06:54\r\n"]
[7.274278, "o", "\r\n\u001b[1;91m╭──────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[7.278019, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m✘ The database is not running.                                  \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[7.2799, "o", "\u001b[1;91m│\u001b[0m                                                                  \u001b[1;91m│\u001b[0m\r\n"]
[7.282657, "o", "\u001b[1;91m│\u001b[0m   InteLIS cannot show a single page without it, however          \u001b[1;91m│\u001b[0m\r\n"]
[7.284513, "o", "\u001b[1;91m│\u001b[0m   healthy the web server is.                                     \u001b[1;91m│\u001b[0m\r\n\u001b[1;91m╰──────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
[7.284608, "o", "  Web server     \u001b[1;92m✔\u001b[0m  running\r\n"]
[7.284683, "o", "  PHP            \u001b[1;92m✔\u001b[0m  8.4.27, all 25 extensions loaded\r\n"]
[7.284821, "o", "  Files          \u001b[1;92m✔\u001b[0m  readable and writable\r\n"]
[7.285869, "o", "  Disk           \u001b[1;92m✔\u001b[0m  416G free\r\n  Database       \u001b[1;91m✘\u001b[0m  stopped\r\n"]
[7.285964, "o", "  Site           \u001b[1;91m✘\u001b[0m  error 500\r\n"]
[7.286097, "o", "  InteLIS        \u001b[1;93m!\u001b[0m  5.8.3 from 27 Oct 2026, an update from 29 Oct 2026 is available\r\n"]
[7.325405, "o", "\r\n\u001b[1mDatabase\u001b[0m\r\n"]
[7.403226, "o", "\r\n\u001b[1;91m╭──────────────────────────────────────────────────────────────────╮\u001b[0m\r\n"]
[7.405494, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m✘ Settings were added to /etc/mysql/my.cnf above the first      \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[7.406913, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m  [section] heading, and the database will not read that file   \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[7.408277, "o", "\u001b[1;91m│\u001b[0m \u001b[1;91m  at all.                                                       \u001b[0m \u001b[1;91m│\u001b[0m\r\n"]
[7.409693, "o", "\u001b[1;91m│\u001b[0m                                                                  \u001b[1;91m│\u001b[0m\r\n"]
[7.411745, "o", "\u001b[1;91m│\u001b[0m   Every setting has to sit under a heading such as [mysqld].     \u001b[1;91m│\u001b[0m\r\n"]
[7.413049, "o", "\u001b[1;91m│\u001b[0m   The server stops at the first line and never starts.           \u001b[1;91m│\u001b[0m\r\n"]
[7.41316, "o", "\u001b[1;91m╰──────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[7.413266, "o", "\r\n  Server         \u001b[1;91m✘\u001b[0m  MySQL, stopped\r\n"]
[7.414183, "o", "  Disk           \u001b[1;92m✔\u001b[0m  416G free\r\n"]
[7.41425, "o", "  Memory         \u001b[1;92m✔\u001b[0m  enough\r\n"]
[7.414373, "o", "  Settings       \u001b[1;91m✘\u001b[0m  a setting is refused\r\n  Data files     \u001b[1;92m✔\u001b[0m  /var/lib/mysql\r\n  InteLIS login  \u001b[2m·\u001b[0m  not checked\r\n"]
[7.414629, "o", "\r\n\u001b[1mRepairs\u001b[0m\r\n"]
[7.414698, "o", "  \u001b[1;96m→\u001b[0m  Disable the settings that were added above the first heading in /etc/mysql/my.cnf.\r\n     Do this now? [y/N]: "]
[8.618766, "o", "y\r\n"]
[8.625878, "o", "  \u001b[1;92m✔\u001b[0m  Done.\r\n"]
[8.62728, "o", "  \u001b[1;96m→\u001b[0m  Starting the database...\r\n"]
