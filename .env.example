DOMAIN=intelis
APACHE_PORT=80

MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATABASE=vlsm
MYSQL_USER=
MYSQL_PASSWORD=

# --- Local review tooling (not read by the application) ---
# Names the CLI that bin/dev/review invokes, as a command line rather than a bare binary,
# so a reviewer that takes a subcommand and one that takes a flag are both a setting here:
#   REVIEW_AGENT='<your-review-cli> review'
#   REVIEW_AGENT='<your-review-cli> -p'
# Set it in your own untracked .env, or export it from your shell profile. Deliberately
# left empty in the example so no tool name is committed.
REVIEW_AGENT=
# Set to 1 if that CLI reads its prompt from standard input instead of a final argument.
REVIEW_AGENT_STDIN=
