[Unit]
Description=InteLIS remote command runner (root-privileged dispatcher)
Documentation=file:///usr/local/share/doc/intelis/remote-command-plane.md
ConditionPathExists=/usr/local/bin/intelis-runner

[Service]
Type=oneshot
ExecStart=/usr/local/bin/intelis-runner
# Filesystem hardening was tried here and does not fit what this unit does.
#
# ProtectSystem=strict with a ReadWritePaths allowlist assumes the runner only
# touches the application. It does not: its whitelisted commands include
# "upgrade", and upgrade.sh manages the operating system around the application
# — it writes /root/.my.cnf, tunes /etc/mysql, touches /var/log/mysql, switches
# PHP versions and restarts services. Under the sandbox each of those fails as a
# read-only filesystem, one at a time, and the upgrade dies partway through
# having already changed things.
#
# Enumerating every path upgrade.sh might touch is not a boundary, it is a list
# that goes stale the next time that script learns to configure something. The
# real boundary is elsewhere and is unaffected by this: the runner accepts only
# command names from a hardcoded whitelist, refuses anything else, verifies a
# nonce so a command cannot be replayed, and stops entirely when the kill-switch
# file is present. A root process whose job is to run the system updater cannot
# also be confined to the application directory.
ProtectSystem=false
ProtectHome=false
PrivateTmp=true
NoNewPrivileges=false
# NoNewPrivileges must be false because intelis-update needs to sudo to www-data
# during composer operations. The runner itself already runs as root.
TimeoutStartSec=7200
Nice=10
