# Git
.git
.gitignore

# IDE/editor
.vscode/
.idea/

# OS files
*.DS_Store
*.DS_Store.orig

# DDEV
.ddev/

# Docker data (avoid recursive copy)
docker/mysql/data/

# A developer's own instance config. It is gitignored, so it never reaches the
# repository — but the Docker build context is not git, and without this the
# image carries whichever database password and STS URL happened to be on the
# machine that built it. The entrypoint creates this file from the dist template
# when it is absent, which is what should happen.
configs/config.*.php
!configs/config.production.dist.php

# Logs, runtime state
*.log
*error_log
*.pid
*.orig
*.lock
# composer.lock has to reach the image. Without it `composer install` has no
# lock to install from, silently resolves every dependency afresh, and the
# resulting image is whatever upstream published that morning rather than the
# set this release was built and tested against. Two images built from the same
# commit a week apart were not the same image.
!composer.lock
.cron_heartbeat

# Node modules
**/node_modules/

# Uploads and temporary files
public/uploads/*
public/temporary/*

# Var directory
var/

# Cache and logs directories
cache/
logs/
audit-trail/
metadata/

# Backups
backups/
backup/

# Local dump files
dump-*

# Misc
temp.ini
rector.php
.env
