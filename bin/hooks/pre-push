#!/usr/bin/env bash
# pre-push — say so when publishing has stopped working.
#
# Labs upgrade to the `stable` branch, which CI fast-forwards to any commit on
# master that passed Verify. So the normal case needs no warning at all: push,
# and a few minutes later it is published. This hook used to fire on every push
# to say "remember to run composer ship", which was the right warning for a
# process that depended on somebody remembering, and is noise now that nothing
# does.
#
# What is still worth saying is the opposite: work that is ALREADY on origin and
# still not published. That means Verify has been failing, or the publish
# workflow is stuck — and both are silent failures whose symptom is labs quietly
# not receiving fixes, which is the exact thing this whole arrangement exists to
# prevent. Checked before this push rather than after, because the commits being
# pushed now have not had their chance yet.
#
# It never blocks. A push refused over paperwork would be worse than the problem.

set -u

remote_ref_is_master=0
master_local_sha=""
master_remote_sha=""
# `|| [ -n "${remote_ref:-}" ]` catches a final line with no trailing newline:
# read fills the variables but still reports EOF, so a plain `while read` drops
# it. Git itself terminates every line, but a global core.hooksPath dispatcher
# that forwards stdin with `printf '%s'` does not, and then this hook would
# silently do nothing.
while read -r _local_ref local_sha remote_ref remote_sha || [ -n "${remote_ref:-}" ]; do
    case "$remote_ref" in
        refs/heads/master)
            remote_ref_is_master=1
            master_local_sha="$local_sha"
            master_remote_sha="$remote_sha"
            ;;
    esac
done

[ "$remote_ref_is_master" -eq 1 ] || exit 0

# ---------------------------------------------------------------------------
# Every commit being pushed has been through a review.
#
# This one DOES block, unlike the warning below, because the thing it prevents
# is not paperwork. A push to master is published to labs by CI on a green
# Verify, so an unreviewed commit here is an unreviewed commit in installations
# a few minutes later. That has happened: a migration was pushed without a
# review, reached stable, and the review it should have had first found two P1
# defects in it.
#
# It is deliberately quiet where it cannot know the answer. The ledger is
# per-clone and never committed, so a fresh clone, a colleague's checkout and CI
# all have no ledger and this does nothing at all -- it can only ever hold back
# a push from a machine that is actually keeping the record.
#
# `git push --no-verify` skips it, which is the right escape hatch: the point is
# to stop it happening by accident, not to make it impossible on purpose.
# ---------------------------------------------------------------------------
ledger="${REVIEW_LEDGER:-}"
if [ -z "$ledger" ] && [ -f .env ]; then
    ledger=$(awk -F= '$0 ~ "^[[:space:]]*REVIEW_LEDGER[[:space:]]*=" {
        sub(/^[^=]*=[[:space:]]*/, ""); gsub(/^["'"'"']|["'"'"']$/, ""); print; exit }' .env)
fi
[ -n "$ledger" ] || ledger="$(git rev-parse --git-dir)/reviewed-commits.txt"

if [ -f "$ledger" ] && [ -n "$master_local_sha" ]; then
    # A branch that does not exist on the remote yet reports the null sha; fall
    # back to whatever the last fetch saw rather than treating the whole history
    # as new and unreviewed.
    range_base="$master_remote_sha"
    case "$master_remote_sha" in
        ''|*[!0]*) : ;;
        *) range_base="" ;;
    esac
    if [ -z "$range_base" ]; then
        range_base=$(git rev-parse --verify --quiet refs/remotes/origin/master || echo "")
    fi

    if [ -n "$range_base" ]; then
        unreviewed=""
        # --no-merges: a merge introduces no change of its own to read.
        while read -r sha; do
            [ -n "$sha" ] || continue
            grep -q "^$sha" "$ledger" 2>/dev/null && continue
            unreviewed="$unreviewed$sha
"
        done <<EOF
$(git rev-list --no-merges "$range_base..$master_local_sha" 2>/dev/null)
EOF

        if [ -n "$unreviewed" ]; then
            count=$(printf '%s' "$unreviewed" | grep -c .)
            printf '\n\033[31m✋ push blocked\033[0m — %s commit(s) have not been reviewed:\n\n' "$count"
            printf '%s' "$unreviewed" | while read -r sha; do
                [ -n "$sha" ] && git log -1 --format='    %h %s' "$sha"
            done
            printf '\n  A push to master reaches labs on the next green Verify, so this is\n'
            printf '  the last point at which a review still comes before the installation.\n\n'
            printf '    \033[1mbin/dev/review <sha>\033[0m       review one\n'
            printf '    \033[1mbin/dev/review --since-last\033[0m  review everything new\n\n'
            printf '  Someone else committing into this tree is the usual reason for a\n'
            printf '  surprise here: their commits are yours to push, and to read first.\n'
            printf '  Deliberately unreviewed: \033[1mgit push --no-verify\033[0m\n\n'
            exit 1
        fi
    fi
fi

# Whatever the last fetch saw. Deliberately no network call — a hook that hangs
# on a bad connection is a hook people disable.
git rev-parse --verify --quiet refs/remotes/origin/stable >/dev/null || exit 0
git rev-parse --verify --quiet refs/remotes/origin/master >/dev/null || exit 0

stuck=$(git rev-list --count refs/remotes/origin/stable..refs/remotes/origin/master 2>/dev/null || echo 0)
[ "$stuck" -gt 0 ] || exit 0

# One commit behind is just a run still in flight — Verify takes a few minutes,
# and a push made while the previous one is still building is normal.
[ "$stuck" -gt 1 ] || exit 0

printf '\n\033[33m⚠ %s commit(s) on origin/master have not reached stable.\033[0m\n' "$stuck"
printf '  Labs upgrade to stable, so these are not in any installation yet:\n\n'
git log --oneline --no-decorate \
    refs/remotes/origin/stable..refs/remotes/origin/master 2>/dev/null | head -8 | sed 's/^/    /'
[ "$stuck" -gt 8 ] && printf '    … and %s more\n' "$((stuck - 8))"
printf '\n  CI publishes on a green Verify, so this usually means Verify is red\n'
printf '  or the Publish workflow needs a look:\n'
printf '  \033[1mgh run list --workflow Verify --branch master --limit 5\033[0m\n\n'

exit 0
